<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Keypad keys (digits and function keys): same look as a normal button but with a larger
         label. The style has no parent on purpose — everything except the attributes listed here
         keeps coming from the Material3 theme's default button style. -->
    <!-- The explicit parent="" stops Android from looking for an implicit "Widget.App" style. -->
    <style name="Widget.App.KeypadButton" parent="">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- The five "special" keys ([+/-] [NEXT] [CLEAR] [TARGET] [DEL]) additionally carry the
         rose background. -->
    <style name="Widget.App.KeypadButton.Special" parent="Widget.App.KeypadButton">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/button_rose_tint</item>
    </style>
</resources>
