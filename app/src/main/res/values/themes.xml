<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme._24Solver" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- An off-white window background instead of Material3's #FFFBFE pure white: a screen full
             of large tinted keys looks glaring against pure white. The dark counterpart is in
             values-night/colors-background.xml, so following the system theme still works. -->
        <item name="android:colorBackground">@color/background</item>
    </style>

    <!-- Transparent system bars for edge-to-edge. These used to live in values-v23, which is
         unnecessary now that minSdk is 24. -->
    <style name="Theme._24Solver" parent="Base.Theme._24Solver">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>
</resources>
