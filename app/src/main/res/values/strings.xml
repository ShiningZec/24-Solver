<resources>
    <!-- The product's name, not a label: it stays the same in every locale. -->
    <string name="app_name" translatable="false">24 Solver</string>
    <!-- Labels shown in the action bar by the navigation graph -->
    <string name="first_fragment_label">24 Solver</string>
    <string name="second_fragment_label">Answers</string>
    <string name="settings_fragment_label">Settings</string>

    <!-- Input screen: labels applied by FirstFragment.refreshDisplay() -->
    <!-- e.g. "TARGET: 24" -->
    <string name="target_label">TARGET: %1$d</string>
    <!-- Shown while Solver.solve() runs on a background dispatcher -->
    <string name="solving">SOLVING…</string>
    <!-- e.g. "NUMBERS: 1, 2, 3" -->
    <string name="numbers_label">NUMBERS: %1$s</string>
    <string name="numbers_empty">(none)</string>
    <!-- e.g. "INPUT: 12" / "TARGET INPUT: -24" -->
    <string name="current_input_label">INPUT: %1$s</string>
    <string name="target_input_label">TARGET INPUT: %1$s</string>
    <string name="input_empty">_</string>

    <!-- Buttons -->
    <string name="btn_next">NEXT</string>
    <string name="btn_target">TARGET</string>
    <string name="btn_solve">SOLVE</string>
    <string name="btn_clear">CLEAR</string>
    <string name="btn_del">DEL</string>
    <string name="btn_sign">+/-</string>
    <string name="btn_back">BACK</string>

    <!-- Keypad digit labels. Not translatable: the keys type the ASCII digits the input parser
         accepts, so they must not follow the locale's numbering system. -->
    <string name="digit_0" translatable="false">0</string>
    <string name="digit_1" translatable="false">1</string>
    <string name="digit_2" translatable="false">2</string>
    <string name="digit_3" translatable="false">3</string>
    <string name="digit_4" translatable="false">4</string>
    <string name="digit_5" translatable="false">5</string>
    <string name="digit_6" translatable="false">6</string>
    <string name="digit_7" translatable="false">7</string>
    <string name="digit_8" translatable="false">8</string>
    <string name="digit_9" translatable="false">9</string>

    <!-- Hints / errors -->
    <!-- A single CLEAR press is silent; only the deliberate long press reports back. -->
    <string name="msg_cleared_all">All Numbers Set to Default</string>
    <string name="err_empty_input">Enter a number first</string>
    <string name="err_no_numbers">Add at least one number before solving (type digits, then NEXT)</string>
    <plurals name="err_max_numbers">
        <item quantity="one">At most %1$d candidate number is allowed</item>
        <item quantity="other">At most %1$d candidate numbers are allowed</item>
    </plurals>
    <string name="err_number_range">Each candidate number must satisfy |x| &lt; %1$d</string>
    <string name="err_target_range">The target must be within ±%1$d</string>
    <string name="err_solver">Solver rejected the input: %1$s</string>

    <!-- AdMob app ID, referenced by AndroidManifest.xml (meta-data
         com.google.android.gms.ads.APPLICATION_ID). Google's official sample app ID is declared
         here so a debug build keeps working; the SDK refuses to start without one.
         TODO: replace with this app's real AdMob app ID (AdMob console → App settings → App ID,
         format ca-app-pub-…~…) before releasing. -->
    <string name="admob_app_id" translatable="false">ca-app-pub-3940256099942544~3347511713</string>

    <!-- Result screen -->
    <plurals name="result_header">
        <item quantity="one">%1$d answer for target %2$d from %3$s</item>
        <item quantity="other">%1$d answers for target %2$d from %3$s</item>
    </plurals>
    <plurals name="result_header_essential">
        <item quantity="one">%1$d essentially different answer for target %2$d from %3$s</item>
        <item quantity="other">%1$d essentially different answers for target %2$d from %3$s</item>
    </plurals>
    <string name="result_line">%1$d. %2$s</string>
    <string name="result_empty">No expression built from these numbers reaches the target.</string>
    <!-- The switch between every expression and one per equivalence class -->
    <string name="result_toggle_all">All (%1$d)</string>
    <string name="result_toggle_essential">Essential (%1$d)</string>

    <!-- Settings -->
    <!-- The toolbar button that opens the settings screen (also its content description). -->
    <string name="settings_open">Settings</string>
    <string name="settings_language_title">Language</string>
    <string name="settings_language_helper">Takes effect when you leave this screen.</string>
    <!-- Shown under the list: which language is on screen, and which is waiting for a restart. -->
    <string name="settings_language_active">In use now: %1$s</string>
    <string name="settings_language_pending">On leaving: %1$s</string>
    <string name="msg_language_pending">The language will change when you leave the settings screen.</string>
    <!-- "Follow the system language". The three languages below are named in their own language
         and are therefore not translated. -->
    <string name="language_system">Follow system</string>
    <string name="language_chinese" translatable="false">中文</string>
    <string name="language_english" translatable="false">English</string>
    <string name="language_japanese" translatable="false">日本語</string>

    <string name="settings_default_target_title">Default target</string>
    <string name="settings_default_target_current">Current: %1$s</string>
    <!-- The slider node that hands the value over to the number field below. -->
    <string name="default_target_customize" translatable="false">CUSTOMIZE</string>
    <string name="settings_default_target_value">%1$d</string>
    <string name="settings_default_target_hint">Custom default target</string>
    <string name="settings_default_target_helper">A whole number within ±%1$d. Used when the screen opens and after a long press on CLEAR; it never changes the target in use.</string>
    <string name="err_default_target_not_a_number">Enter a whole number</string>
    <string name="err_default_target_range">Must be within ±%1$d</string>

    <string name="settings_sound_title">Keypad sound</string>
    <string name="settings_sound_helper">Plays a note when a keypad key is pressed. Off silences the keypad, SOLVE and the long-press gestures.</string>
</resources>
