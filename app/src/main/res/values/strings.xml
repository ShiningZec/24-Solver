         TODO: replace with this app's real AdMob app ID (AdMob console → App settings → App ID,
         format ca-app-pub-…~…) before releasing. -->
    <string name="admob_app_id" translatable="false">ca-app-pub-3940256099942544~3347511713</string>

    <!-- Result screen -->
    <string name="result_header">%1$d answer(s) for target %2$d from %3$s</string>
    <string name="result_line">%1$d. %2$s</string>
    <string name="result_empty">No expression built from these numbers reaches the target.</string>
