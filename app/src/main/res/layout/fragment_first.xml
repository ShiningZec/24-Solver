<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".FirstFragment">

    <!-- All three labels are written by FirstFragment.refreshDisplay();
         tools:text only affects the IDE preview. -->
    <TextView
        android:id="@+id/text_target"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:textSize="24sp"
        tools:text="TARGET: 24" />

    <TextView
        android:id="@+id/text_numbers"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:textSize="24sp"
        tools:text="NUMBERS: (none)" />

    <TextView
        android:id="@+id/text_current_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:textSize="24sp"
        tools:text="INPUT: _" />

    <!-- Keypad: five rows of keys. The band takes 4 of 5 weight units, i.e. 80% of the vertical
         space the rows used to fill (the last unit is the spacer below), so every key ends up
         roughly 80% as tall as before while its label stays fully readable.
         Keys carry horizontal margins for the left/right gaps; label size and the rose background
         come from res/values/styles.xml. -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button1"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="1" />

            <Button
                android:id="@+id/button2"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="2" />

            <Button
                android:id="@+id/button3"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button4"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="4" />

            <Button
                android:id="@+id/button5"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="5" />

            <Button
                android:id="@+id/button6"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button7"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="7" />

            <Button
                android:id="@+id/button8"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="8" />

            <Button
                android:id="@+id/button9"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="9" />
        </LinearLayout>

        <!-- 4th row: [+/-] negates the value being typed, 0, and NEXT which commits it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_sign"
                style="@style/Widget.App.KeypadButton.Special"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_sign" />

            <Button
                android:id="@+id/button0"
                style="@style/Widget.App.KeypadButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="0" />

            <Button
                android:id="@+id/button_next"
                style="@style/Widget.App.KeypadButton.Special"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_next" />
        </LinearLayout>

        <!-- 5th row: CLEAR (tap clears the active scope silently, long press resets everything),
             DEL (tap backspaces, long press drops the last candidate) and the TARGET latch. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_clear"
                style="@style/Widget.App.KeypadButton.Special"
                android:hapticFeedbackEnabled="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_clear" />

            <Button
                android:id="@+id/button_del"
                style="@style/Widget.App.KeypadButton.Special"
                android:hapticFeedbackEnabled="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/btn_del" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_target"
                style="@style/Widget.App.KeypadButton.Special"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/btn_target" />
        </LinearLayout>
    </LinearLayout>

    <!-- The fifth weight unit: breathing room between the keypad and SOLVE. -->
    <View
        android:id="@+id/keypad_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- SOLVE is deliberately taller than a default button (~+20%). -->
    <Button
        android:id="@+id/button_solve"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_solve" />
</LinearLayout>
