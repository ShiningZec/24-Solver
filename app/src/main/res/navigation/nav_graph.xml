<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.a24solver.wakusei.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.a24solver.wakusei.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <!-- Reached from the toolbar button on either screen, so it is a sibling of both rather than
         the target of one particular action; the up arrow returns to wherever it was opened from. -->
    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.a24solver.wakusei.SettingsFragment"
        android:label="@string/settings_fragment_label"
        tools:layout="@layout/fragment_settings" />

    <!-- Opened automatically on the first start (see FirstFragment) and afterwards from the
         settings screen; a sibling as well, so the up arrow always goes back where it came from. -->
    <fragment
        android:id="@+id/HelpFragment"
        android:name="com.a24solver.wakusei.HelpFragment"
        android:label="@string/help_title"
        tools:layout="@layout/fragment_help" />
</navigation>