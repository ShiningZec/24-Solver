<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme._24Solver"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme._24Solver"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by the Google Mobile Ads SDK (play-services-ads): the library merges its
             MobileAdsInitProvider into this manifest, and that provider runs inside
             ActivityThread.handleBindApplication — before Application.onCreate — where it throws
             IllegalStateException ("Missing application ID") if this meta-data is absent or
             malformed. That surfaces as the launch crash
                 RuntimeException: Unable to get provider
                 com.google.android.gms.ads.MobileAdsInitProvider
             and cannot be caught by application code, so the tag below is what keeps the ads
             dependency safe to have on the classpath.
             TODO: point @string/admob_app_id at the real AdMob app ID of this app. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Lets AppCompat remember the language the user picked in the settings screen on API
             levels below 33 (from 33 on, the system stores it for the app). Without this the choice
             would be forgotten as soon as the process dies. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>